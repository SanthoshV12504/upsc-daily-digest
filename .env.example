# UPSC Daily Current Affairs Digest Automation Setup

# 1. Telegram Bot Settings
# Create a bot via @BotFather on Telegram to get your bot token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Can be channel ID like @my_upsc_channel or user/group chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. AI Summarization Key (Google Gemini API)
# Get a free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Google Sheets Integration (Optional - Falls back to local CSV/JSON log if empty)
# Service Account JSON key path or spreadsheet ID
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# 4. Automation Schedule (Cron Format)
# Default: Runs every day at 7:00 AM IST (0 7 * * *)
CRON_SCHEDULE=0 7 * * *

# 5. Server Port
PORT=3000
